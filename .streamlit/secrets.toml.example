# Copiar a .streamlit/secrets.toml (NO subir a git)
[supabase]
url = "https://TU-PROYECTO.supabase.co"
key = "TU_SERVICE_ROLE_KEY"   # Supabase > Project Settings > API

# Correo con el que entra cada persona (Streamlit Cloud) -> id_empleado del listado de personal.
# Quien no tiene jefe en el organigrama ve todo; los demás ven su equipo hacia abajo.
[accesos]
"director@empresa.com" = "E000001"
"lider@empresa.com" = "E000002"

# Contraseñas (hash PBKDF2; generar con: python -m tools.crear_usuario). Streamlit Community Cloud
# no pasa el correo del visitante a la app, así que cada persona entra con correo + contraseña.
[usuarios]
"director@empresa.com" = "pbkdf2_sha256$200000$<sal>$<hash>"
